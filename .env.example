# Copy this file to .env.local and fill in your own values.
# Never commit .env.local.

# --- Supabase (public values; safe in the browser because RLS protects data) ---
# Project Settings > API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Do NOT add the service role key anywhere in this app.

# --- AI providers (server only; never prefix with NEXT_PUBLIC_) ---
# Set at least one key to turn on the assistant. With both keys, the other
# provider is the backup, so a request can reach both.
# Which provider is tried first: gemini (default) or groq.
AI_PRIMARY_PROVIDER=gemini

GEMINI_API_KEY=
# Model used by every AI feature. Check https://ai.google.dev/gemini-api/docs/models for current IDs.
GEMINI_MODEL=gemini-3.8-flash
# Optional: a different model for voice transcription (defaults to GEMINI_MODEL).
# GEMINI_TRANSCRIPTION_MODEL=
# Optional: request timeout in milliseconds. Capped at 20000, or 8000 when GROQ_API_KEY is set.
# GEMINI_TIMEOUT_MS=20000

GROQ_API_KEY=
# Optional: defaults to openai/gpt-oss-20b.
# GROQ_MODEL=
# Optional: defaults to whisper-large-v3-turbo.
# GROQ_TRANSCRIPTION_MODEL=
# Optional: request timeout in milliseconds, capped at 30000.
# GROQ_TIMEOUT_MS=20000

# --- Local demo mode ---
# The demo stores fictional data in the browser only. Set to false to hide it.
NEXT_PUBLIC_ENABLE_DEMO=true
# Lets the demo (no account) call the AI endpoints. Set to true only for local
# testing: on a public deployment, anyone could use your AI quota without an account.
ALLOW_DEMO_AI=false
