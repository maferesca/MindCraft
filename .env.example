# Copy this file to .env.local and fill in your own values.
# Never commit .env.local.

# --- Supabase (public values; safe in the browser because RLS protects data) ---
# Project Settings > API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
# Do NOT add the service role key anywhere in this app.

# --- Gemini (server only; never prefix with NEXT_PUBLIC_) ---
GEMINI_API_KEY=
# Model used by every AI feature. Check https://ai.google.dev/gemini-api/docs/models for current IDs.
GEMINI_MODEL=gemini-3.8-flash
# Optional: a different model for voice transcription (defaults to GEMINI_MODEL).
# GEMINI_TRANSCRIPTION_MODEL=
# Optional: request timeout in milliseconds.
# GEMINI_TIMEOUT_MS=20000

# --- Local demo mode ---
# The demo stores fictional data in the browser only. Set to false to hide it.
NEXT_PUBLIC_ENABLE_DEMO=true
# Lets the demo (no account) call the AI endpoints. Keep false on public deployments.
ALLOW_DEMO_AI=false
